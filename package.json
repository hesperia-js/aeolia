{
  "name": "aeolia",
  "version": "1.0.0-alpha.1",
  "description": "A framework-agnostic reactive state layer built on signals",
  "keywords": [
    "javascript",
    "reactive",
    "state-management",
    "typescript"
  ],
  "homepage": "https://github.com/hesperia-js/aeolia",
  "bugs": "https://github.com/hesperia-js/aeolia/issues",
  "license": "MPL-2.0",
  "author": {
    "name": "Halk <Werberth Lins>",
    "email": "halkliff@pm.me",
    "url": "https://halkliff.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hesperia-js/aeolia.git"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "COPYING",
    "LICENSE-COMMERCIAL.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./reactive": {
      "types": "./dist/reactive/index.d.ts",
      "import": "./dist/reactive/index.js",
      "default": "./dist/reactive/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "bun run build && bun test tests",
    "test:package": "bun run build && bun test tests/package && bun run tests/package/run.ts",
    "prepublishOnly": "bun run test:package",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.63.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@types/bun": "^1.4",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}
